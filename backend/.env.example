# Fairhire Environment Configuration
# Copy this file to .env and fill in your keys

# Operating Mode
DEMO_MODE=false
PORT=8000
HOST=0.0.0.0

# LLM Provider: "groq", "anthropic", or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# External Verification APIs (Optional - falls back to null if empty)
GOOGLE_SAFE_BROWSING_API_KEY=

# Community Review threshold for public aggregate display
MIN_REVIEWS=3
